{
  "_about": "Regex patterns (case-insensitive, first match wins, order matters) mapping room names read from the plan to space types in space_types.json. Includes common Arabic names. Unmatched names become 'unknown' and are raised at Gate 1.",
  "patterns": [
    [
      "shaft|riser|duct\\s*shaft|\\bs\\.?d\\b|بئر|شافت",
      "shaft"
    ],
    [
      "courtyard|open\\s*to\\s*sky|terrace|balcony|verandah|\\bver\\b|light\\s*well|فناء|شرفة|بلكونة",
      "outdoor"
    ],
    [
      "public\\s*(toilet|wc)|gents|ladies",
      "toilet_public"
    ],
    [
      "bath|toilet|\\bwc\\b|w\\.c|powder|حمام|دورة\\s*مياه",
      "bath"
    ],
    [
      "master\\s*(bed|br)|غرفة\\s*نوم\\s*رئيسية",
      "master_bedroom"
    ],
    [
      "maid|driver|servant|nanny|خادمة|سائق",
      "maid_room"
    ],
    [
      "bed\\s*room|\\bbed\\b|\\bbr\\s*\\d*\\b|^room\\b|غرفة\\s*نوم|نوم",
      "bedroom"
    ],
    [
      "majlis|majles|reception|مجلس",
      "majlis"
    ],
    [
      "dining|dinning|طعام",
      "dining"
    ],
    [
      "kitchen|مطبخ",
      "kitchen"
    ],
    [
      "pantry|كوفي|بوفيه",
      "pantry"
    ],
    [
      "laundry|غسيل",
      "laundry"
    ],
    [
      "dress|closet|wardrobe|ملابس",
      "dressing"
    ],
    [
      "stair|درج",
      "stair"
    ],
    [
      "corridor|passage|lobby|ممر",
      "corridor"
    ],
    [
      "entrance|hall|foyer|مدخل",
      "hall"
    ],
    [
      "living|family|lounge|sitting|drg\\.?\\s*room|drawing\\s*room|صالة|معيشة",
      "living"
    ],
    [
      "store|storage|linen|مخزن|مستودع",
      "store"
    ],
    [
      "office|study|مكتب",
      "office"
    ],
    [
      "meeting|conference|اجتماعات",
      "meeting"
    ],
    [
      "shop|retail|showroom|محل",
      "retail"
    ],
    [
      "elec|\\bit\\b|server|كهرباء",
      "electrical"
    ]
  ]
}